# Copy to .env.local and fill in — never commit .env.local

ANTHROPIC_API_KEY=sk-ant-...          # Claude AI (required for the CLAUDE tab)
HOST_AGENT_TOKEN=native-dev-token     # Shared secret between web and host agent
BLOB_READ_WRITE_TOKEN=vercel_blob_... # Optional — enables Vercel Blob for QuickShare in production
BLOB_STORE_ID=store_...               # Set automatically when a Blob store is linked
